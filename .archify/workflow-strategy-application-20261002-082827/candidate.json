  "cards": [
    {
      "dot": "emerald",
      "title": "When it runs",
      "items": [
        "Cron 09:15 / 13:30 / 22:00 (app TZ, default Asia/Shanghai); skipped when every market is closed",
        "Manual: POST /strategy-signals/refresh (background thread) or wait=true; POST /entry-candidates/refresh",
        "Startup: ensure_strategy_catalog() (server.py) plus a bootstrap evaluation at +15s"
      ]
    },
    {
      "dot": "cyan",
      "title": "How a strategy applies",
      "items": [
        "Context per run: market regime (breadth/change/active), cross-section rank & crowding, 72h news event score (strategy_engine.py)",
        "Per candidate × strategy tag: base + alpha/catalyst/quality − risk/crowd, then × strategy weight × regime multiplier × IC-calibrated factor weights",
        "Constraints demote over-quota signals to watch: unheld ≤30 CN / 20 HK / 20 US, high-risk ratio ≤35/32/30%, single-strategy share ≤42%",
        "Consumers read active signals: Opportunities UI, assistant tools, paper-trading entries (buy/add with entry window)"
      ]
    },
    {
      "dot": "violet",
      "title": "Self-calibration loop",
      "items": [
        "Every 6h: evaluate 1/3/5/10-day outcomes for the last 60 days of signals",
        "Rebalance strategy weights (α=0.35, ≥8 samples, 45-day window), then per-factor IC/IR calibration per market",
        "The new weights feed the next scheduled or manual refresh"
      ]
    }
  ]
